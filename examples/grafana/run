#!/usr/bin/env python3
"""An example toolworks-hub source: one query against a Grafana data source.

Copy this folder to ~/.config/agent-toolworks/sources/grafana/, copy
config.example.json to config.json beside it and fill it in, and store an API
token (a Grafana service account token with the Viewer role is enough):

  security add-generic-password -s toolworks-hub-grafana -a grafana -w

The -w with no value makes macOS prompt for the token, so it never lands in
your shell history. On Linux, or to override, set GRAFANA_TOKEN instead.

What it shows how to do:

- keep a secret out of every file: the token comes from the Keychain or the
  environment, at run time, and is sent only to the configured Grafana;
- keep detect offline: it checks the config and that a token exists, and never
  calls the network, because it runs on every hub start;
- turn an upstream failure into an error the hub shows (a non-zero exit with
  the reason on stderr), never into an empty chart that looks like no data.

GRAFANA_SOURCE_CONFIG names another config file (scripts/verify uses it).
"""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
REQUIRED = ("url", "datasource_uid", "query")


def out(value):
    json.dump(value, sys.stdout)
    sys.stdout.write("\n")


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def config():
    """(config, problem)."""
    path = os.environ.get("GRAFANA_SOURCE_CONFIG") or os.path.join(HERE, "config.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return None, "there is no config at %s" % path
    except (OSError, ValueError) as e:
        return None, "the config at %s could not be read (%s)" % (path, e)
    missing = [k for k in REQUIRED if not isinstance(cfg.get(k), str) or not cfg[k]]
    if missing:
        return None, "the config at %s has no %s" % (path, ", ".join(missing))
    return cfg, None


def token(cfg):
    if os.environ.get("GRAFANA_TOKEN"):
        return os.environ["GRAFANA_TOKEN"]
    service = cfg.get("keychain_service") or "toolworks-hub-grafana"
    try:
        p = subprocess.run(["security", "find-generic-password", "-s", service, "-w"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def detect():
    cfg, problem = config()
    if problem:
        return out({"state": "not_set_up", "reason": problem,
                    "fix": "copy config.example.json to config.json in %s and fill it in" % HERE})
    if not token(cfg):
        service = cfg.get("keychain_service") or "toolworks-hub-grafana"
        return out({"state": "not_set_up", "reason": "no Grafana API token in the Keychain or GRAFANA_TOKEN",
                    "fix": "security add-generic-password -s %s -a grafana -w" % service})
    out({"state": "working"})


def query(cfg):
    """The data frames Grafana returns for the configured query, last 6 hours."""
    body = json.dumps({
        "queries": [{"refId": "A", "datasource": {"uid": cfg["datasource_uid"]},
                     "expr": cfg["query"], "intervalMs": 60000, "maxDataPoints": 360}],
        "from": "now-6h", "to": "now",
    }).encode()
    req = urllib.request.Request(cfg["url"].rstrip("/") + "/api/ds/query", data=body, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "Authorization": "Bearer %s" % token(cfg)})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            doc = json.load(r)
    except urllib.error.HTTPError as e:
        fail("Grafana answered %d %s" % (e.code, e.reason))
    except (urllib.error.URLError, OSError, ValueError) as e:
        fail("could not query Grafana at %s (%s)" % (cfg["url"], e))
    result = (doc.get("results") or {}).get("A") or {}
    if result.get("error"):
        fail("Grafana could not run the query: %s" % result["error"])
    return result.get("frames") or []


def series_of(frames):
    """[{name, points}] from Grafana's data frames: one time field and one or
    more number fields per frame, named by their labels."""
    series = []
    for frame in frames:
        fields = (frame.get("schema") or {}).get("fields") or []
        values = (frame.get("data") or {}).get("values") or []
        times = next((values[i] for i, f in enumerate(fields) if f.get("type") == "time"), None)
        if times is None:
            continue
        for i, f in enumerate(fields):
            if f.get("type") != "number" or i >= len(values):
                continue
            labels = f.get("labels") or {}
            name = ", ".join("%s=%s" % kv for kv in sorted(labels.items())) or f.get("name") or "value"
            points = []
            for t, v in zip(times, values[i]):
                when = datetime.fromtimestamp(t / 1000, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                points.append({"t": when, "v": v if isinstance(v, (int, float)) else None})
            series.append({"name": name, "points": points})
    return series


def main(argv):
    cmd = argv[1:]
    if cmd == ["detect"]:
        return detect()
    if cmd in (["fetch", "series"], ["fetch", "latest"]):
        cfg, problem = config()
        if problem:
            fail(problem)
        series = series_of(query(cfg))
        unit = cfg.get("unit")
        if cmd[1] == "series":
            data = {"series": series}
            if unit:
                data["unit"] = unit
            return out({"kind": "timeseries", "data": data})
        last = [(p["t"], p["v"]) for s in series[:1] for p in s["points"] if p["v"] is not None]
        if not last:
            return out({"kind": "stat", "data": {"value": "—", "label": "no data in the last 6 hours"}})
        stat = {"value": round(last[-1][1], 3), "label": series[0]["name"]}
        if unit:
            stat["unit"] = unit
        return out({"kind": "stat", "as_of": last[-1][0], "data": stat})
    print("unknown command: %s" % " ".join(cmd), file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
