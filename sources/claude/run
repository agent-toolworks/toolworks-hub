#!/usr/bin/env python3
"""The hub's built-in source: Claude Code's own data on this machine.

It reads only files Claude Code writes, under each Claude Code folder the hub
names in TOOLWORKS_CLAUDE_DIRS (else $CLAUDE_CONFIG_DIR, default ~/.claude):
transcripts under projects/<folder>/<session id>.jsonl, the plugin records
under plugins/, and the signed-in account's email from the folder's
.claude.json. With more than one folder, sessions and plugins carry an
Account column, so a second account (CLAUDE_CONFIG_DIR=~/.claude-work claude)
is told apart (plugins and the session page; the sessions table has no
room for it). It follows the same contract as every other source and
imports nothing from the hub.

Transcripts are read only as far as the first records that name the
session's directory and branch (HEAD_BYTES at most), except by `show`, which
counts one session's messages. Nothing from a message's content is printed.

Live sessions come from `hub bg list --all-kinds`, through TOOLWORKS_HUB
like any other source would (#7). Their status, title and links are not
printed here: the hub adds them to every table of sessions, whichever
source printed it.
"""
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime

UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
VERSION = re.compile(r"^[0-9]+(\.[0-9]+)*$")
HEAD_BYTES = 256 * 1024
RECENT = 20
DAY = 24 * 3600
BG_TIMEOUT = 8  # seconds for `hub bg list`, inside the fetch's 10
# agent-teller is a separate tool that runs separately; the hub never lists it.
EXCLUDED = frozenset({"agent-teller"})


def claude_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def claude_dirs():
    """Every Claude Code folder to read, the hub's own first."""
    raw = os.environ.get("TOOLWORKS_CLAUDE_DIRS") or ""
    return [d for d in raw.split(os.pathsep) if d] or [claude_dir()]


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def email(folder):
    """The email of the account signed in to a folder, from its .claude.json:
    inside the folder, or ~/.claude.json beside the default ~/.claude."""
    path = os.path.join(folder, ".claude.json")
    default = os.path.expanduser("~/.claude")
    if not os.path.exists(path) and os.path.realpath(folder) == os.path.realpath(default):
        path = os.path.expanduser("~/.claude.json")
    try:
        with open(path, encoding="utf-8") as f:
            account = json.load(f).get("oauthAccount")
        value = account.get("emailAddress")
        return value if isinstance(value, str) and value else None
    except (OSError, ValueError, AttributeError):
        return None


def accounts(dirs):
    """{folder: label} when there is more than one folder, else {}: the
    account's email, with the folder when two share one, else the folder."""
    if len(dirs) < 2:
        return {}
    emails = {d: email(d) for d in dirs}
    out = {}
    for d, e in emails.items():
        if e and list(emails.values()).count(e) == 1:
            out[d] = e
        else:
            out[d] = f"{e} ({tilde(d)})" if e else tilde(d)
    return out


def out(value):
    json.dump(value, sys.stdout)
    sys.stdout.write("\n")


def local(ts):
    return datetime.fromtimestamp(ts).astimezone().strftime("%Y-%m-%d %H:%M")


def from_iso(text):
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def transcripts():
    """(session id, path, mtime, size, Claude Code folder) for every top-level
    transcript in every folder, newest first. Files whose name is not a
    session ID are not transcripts."""
    found = []
    for base in claude_dirs():
        root = os.path.join(base, "projects")
        try:
            folders = os.listdir(root)
        except OSError:
            continue
        for folder in folders:
            d = os.path.join(root, folder)
            try:
                names = os.listdir(d)
            except OSError:
                continue
            for n in names:
                stem, ext = os.path.splitext(n)
                if ext != ".jsonl" or not UUID.match(stem):
                    continue
                path = os.path.join(d, n)
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                found.append((stem, path, st.st_mtime, st.st_size, base))
    found.sort(key=lambda t: t[2], reverse=True)
    return found


def head(path):
    """Directory, branch, Claude Code version and start time, from the first
    records that carry them."""
    fields = (("cwd", "cwd"), ("branch", "gitBranch"), ("version", "version"), ("started", "timestamp"))
    info = {}
    try:
        with open(path, "rb") as f:
            chunk = f.read(HEAD_BYTES)
    except OSError:
        return info
    for line in chunk.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue  # includes a last line cut at HEAD_BYTES
        if not isinstance(rec, dict):
            continue
        for key, name in fields:
            if key not in info and isinstance(rec.get(name), str) and rec[name]:
                info[key] = rec[name]
        if len(info) == len(fields):
            break
    return info


def vkey(v):
    return tuple(int(p) for p in v.split("."))


def detect():
    d = claude_dir()
    if not any(os.path.isdir(x) for x in claude_dirs()):
        out({"state": "not_set_up", "reason": f"there is no Claude Code folder at {d}",
             "fix": "run Claude Code once, or set CLAUDE_CONFIG_DIR to its folder"})
    else:
        out({"state": "working"})


def sessions_today():
    since = time.time() - DAY
    n = sum(1 for t in transcripts() if t[2] >= since)
    out({"kind": "stat", "data": {"value": n, "unit": "sessions", "label": "with activity in the last 24 hours"}})


def live_sessions():
    """`hub bg list --all-kinds`: (every live session, background and
    interactive, problem or None)."""
    hub = os.environ.get("TOOLWORKS_HUB")
    if not hub:
        return [], "TOOLWORKS_HUB is not set, so live sessions are not listed; the hub sets it"
    try:
        r = subprocess.run([hub, "bg", "list", "--all-kinds"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=BG_TIMEOUT)
        doc = json.loads(r.stdout)
    except subprocess.TimeoutExpired:
        return [], f"hub bg list took longer than {BG_TIMEOUT} s"
    except (OSError, ValueError) as e:
        return [], f"hub bg list failed: {e}"
    if not isinstance(doc, dict) or not isinstance(doc.get("sessions"), list):
        return [], f"hub bg list failed: {(doc or {}).get('error') if isinstance(doc, dict) else doc}"
    return doc["sessions"], "; ".join(doc.get("problems") or []) or None


def sessions():
    """The RECENT most recently active sessions, and every live one however
    long ago it was last active. The hub adds each one's status, title and
    the ways to open it, as it does for every session table."""
    found, problem = live_sessions()
    by_id = {t[0]: t for t in transcripts()}
    wanted = list(by_id)[:RECENT]
    started = {}
    for s in found:
        sid = s.get("session_id")
        if sid and UUID.match(sid) and sid not in wanted:
            wanted.append(sid)
            started[sid] = s
    rows = []
    for sid in wanted:
        t = by_id.get(sid)
        if t:
            _, path, mtime, size, _ = t
            h = head(path)
            project = h.get("cwd") or os.path.basename(os.path.dirname(path))
            branch, size = h.get("branch"), round(size / 1024)
        else:  # live, and nothing written yet
            s = started[sid]
            mtime = from_iso(s["started_at"]) if s.get("started_at") else None
            project, branch, size = s.get("cwd"), None, None
        rows.append((mtime or 0, {
            "session": {"ref": "session", "id": sid, "label": sid[:8]},
            "project": project,
            "branch": branch,
            "last-active": local(mtime) if mtime else None,
            "size": size,
        }))
    rows.sort(key=lambda r: r[0], reverse=True)
    columns = [
        {"id": "session", "title": "Session"},
        {"id": "project", "title": "Project"},
        {"id": "branch", "title": "Branch"},
        {"id": "last-active", "title": "Last activity"},
        {"id": "size", "title": "Transcript", "unit": "KB"},
    ]
    result = {"kind": "table", "data": {"columns": columns, "rows": [r for _, r in rows]}}
    if problem:
        result["notice"] = problem
    out(result)


def plugins():
    dirs = claude_dirs()
    label = accounts(dirs)
    columns = [
        {"id": "plugin", "title": "Plugin"},
        {"id": "marketplace", "title": "Marketplace"},
        {"id": "loaded", "title": "Loaded"},
        {"id": "newest", "title": "Newest in cache"},
        {"id": "status", "title": "Status"},
    ]
    if label:
        columns.insert(1, {"id": "account", "title": "Account"})
    result = {"kind": "table", "data": {"columns": columns, "rows": []}}
    notices = []
    for base in dirs:
        notice = folder_plugins(base, result["data"]["rows"], label.get(base))
        if notice:
            notices.append(f"{tilde(base)}: {notice}" if label else notice)
    if notices:
        result["notice"] = "; ".join(notices)
    out(result)


def folder_plugins(base, rows, account):
    """Add one Claude Code folder's plugins to rows; a notice, or None."""
    path = os.path.join(base, "plugins", "installed_plugins.json")
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        return f"could not read installed_plugins.json ({e})"
    if not isinstance(doc, dict):
        return "installed_plugins.json is not an object"
    notice = None
    if doc.get("version") != 2:
        notice = (f"installed_plugins.json is format {doc.get('version')!r}; "
                  f"this source was written for format 2")

    for key, records in sorted((doc.get("plugins") or {}).items()):
        records = [r for r in records if isinstance(r, dict)] if isinstance(records, list) else []
        if not records:
            continue
        rec = next((r for r in records if r.get("scope") == "user"), records[0])
        name, _, market = key.partition("@")
        if name in EXCLUDED:
            continue
        loaded = rec.get("version") if isinstance(rec.get("version"), str) else None
        try:
            cached = [v for v in os.listdir(os.path.join(base, "plugins", "cache", market, name))
                      if VERSION.match(v)]
        except OSError:
            cached = []
        newest = max(cached, key=vkey) if cached else None
        status = "ok"
        if loaded and newest and VERSION.match(loaded) and vkey(newest) > vkey(loaded):
            status = f"stale: {newest} is in the cache; run claude plugin update {name}, then restart"
        row = {"plugin": name, "marketplace": market, "loaded": loaded,
               "newest": newest, "status": status}
        if account:
            row["account"] = account
        rows.append(row)
    return notice


def show_session(sid):
    match = next((t for t in transcripts() if t[0] == sid), None)
    if match is None:
        return out({"widgets": []})
    _, path, mtime, size, base = match
    h = head(path)
    messages = 0
    try:
        with open(path, "rb") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict) and rec.get("type") in ("user", "assistant"):
                    messages += 1
    except OSError:
        pass
    started = from_iso(h["started"]) if "started" in h else None
    facts = [
        ("Messages", f"{messages} (user and assistant records)"),
        ("Project", h.get("cwd")),
        ("Branch", h.get("branch")),
        ("Started", local(started) if started else None),
        ("Last activity", local(mtime)),
        ("Claude Code", h.get("version")),
        ("Transcript", f"{path} ({round(size / 1024)} KB)"),
    ]
    label = accounts(claude_dirs())
    if label:
        facts.insert(0, ("Account", label[base]))
    out({"widgets": [
        {"id": "details", "kind": "list", "title": "Session",
         "data": {"items": [{"text": k, "detail": v} for k, v in facts if v]}},
    ]})


def main(argv):
    cmd = argv[1:3]
    if cmd == ["detect"]:
        return detect()
    if cmd == ["fetch", "sessions-today"]:
        return sessions_today()
    if cmd == ["fetch", "sessions"]:
        return sessions()
    if cmd == ["fetch", "plugins"]:
        return plugins()
    if cmd == ["show", "session"] and len(argv) == 4:
        return show_session(argv[3])
    print(f"unknown command: {' '.join(argv[1:])}", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
