#!/usr/bin/env python3
"""The hub's built-in source: Claude Code's own data on this machine.

It reads only files Claude Code writes, under $CLAUDE_CONFIG_DIR (default
~/.claude): transcripts under projects/<folder>/<session id>.jsonl, and the
plugin records under plugins/. It follows the same contract as every other
source and imports nothing from the hub.

Transcripts are read only as far as the first records that name the
session's directory and branch (HEAD_BYTES at most), except by `show`, which
counts one session's messages. Nothing from a message's content is printed.
"""
import json
import os
import re
import sys
import time
from datetime import datetime

UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
VERSION = re.compile(r"^[0-9]+(\.[0-9]+)*$")
HEAD_BYTES = 256 * 1024
RECENT = 20
DAY = 24 * 3600
# agent-teller is a separate tool that runs separately; the hub never lists it.
EXCLUDED = frozenset({"agent-teller"})


def claude_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def out(value):
    json.dump(value, sys.stdout)
    sys.stdout.write("\n")


def local(ts):
    return datetime.fromtimestamp(ts).astimezone().strftime("%Y-%m-%d %H:%M")


def from_iso(text):
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def transcripts():
    """(session id, path, mtime, size) for every top-level transcript, newest
    first. Files whose name is not a session ID are not transcripts."""
    root = os.path.join(claude_dir(), "projects")
    found = []
    try:
        folders = os.listdir(root)
    except OSError:
        return found
    for folder in folders:
        d = os.path.join(root, folder)
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            stem, ext = os.path.splitext(n)
            if ext != ".jsonl" or not UUID.match(stem):
                continue
            path = os.path.join(d, n)
            try:
                st = os.stat(path)
            except OSError:
                continue
            found.append((stem, path, st.st_mtime, st.st_size))
    found.sort(key=lambda t: t[2], reverse=True)
    return found


def head(path):
    """Directory, branch, Claude Code version and start time, from the first
    records that carry them."""
    fields = (("cwd", "cwd"), ("branch", "gitBranch"), ("version", "version"), ("started", "timestamp"))
    info = {}
    try:
        with open(path, "rb") as f:
            chunk = f.read(HEAD_BYTES)
    except OSError:
        return info
    for line in chunk.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue  # includes a last line cut at HEAD_BYTES
        if not isinstance(rec, dict):
            continue
        for key, name in fields:
            if key not in info and isinstance(rec.get(name), str) and rec[name]:
                info[key] = rec[name]
        if len(info) == len(fields):
            break
    return info


def vkey(v):
    return tuple(int(p) for p in v.split("."))


def detect():
    d = claude_dir()
    if not os.path.isdir(d):
        out({"state": "not_set_up", "reason": f"there is no Claude Code folder at {d}",
             "fix": "run Claude Code once, or set CLAUDE_CONFIG_DIR to its folder"})
    else:
        out({"state": "working"})


def sessions_today():
    since = time.time() - DAY
    n = sum(1 for t in transcripts() if t[2] >= since)
    out({"kind": "stat", "data": {"value": n, "unit": "sessions", "label": "with activity in the last 24 hours"}})


def sessions():
    rows = []
    for sid, path, mtime, size in transcripts()[:RECENT]:
        h = head(path)
        rows.append({
            "session": {"ref": "session", "id": sid, "label": sid[:8]},
            "project": h.get("cwd") or os.path.basename(os.path.dirname(path)),
            "branch": h.get("branch"),
            "last-active": local(mtime),
            "size": round(size / 1024),
        })
    out({"kind": "table", "data": {
        "columns": [
            {"id": "session", "title": "Session"},
            {"id": "project", "title": "Project"},
            {"id": "branch", "title": "Branch"},
            {"id": "last-active", "title": "Last activity"},
            {"id": "size", "title": "Transcript", "unit": "KB"},
        ],
        "rows": rows,
    }})


def plugins():
    columns = [
        {"id": "plugin", "title": "Plugin"},
        {"id": "marketplace", "title": "Marketplace"},
        {"id": "loaded", "title": "Loaded"},
        {"id": "newest", "title": "Newest in cache"},
        {"id": "status", "title": "Status"},
    ]
    result = {"kind": "table", "data": {"columns": columns, "rows": []}}
    path = os.path.join(claude_dir(), "plugins", "installed_plugins.json")
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except FileNotFoundError:
        return out(result)
    except (OSError, ValueError) as e:
        result["notice"] = f"could not read installed_plugins.json ({e})"
        return out(result)
    if not isinstance(doc, dict):
        result["notice"] = "installed_plugins.json is not an object"
        return out(result)
    if doc.get("version") != 2:
        result["notice"] = (f"installed_plugins.json is format {doc.get('version')!r}; "
                            f"this source was written for format 2")

    for key, records in sorted((doc.get("plugins") or {}).items()):
        records = [r for r in records if isinstance(r, dict)] if isinstance(records, list) else []
        if not records:
            continue
        rec = next((r for r in records if r.get("scope") == "user"), records[0])
        name, _, market = key.partition("@")
        if name in EXCLUDED:
            continue
        loaded = rec.get("version") if isinstance(rec.get("version"), str) else None
        try:
            cached = [v for v in os.listdir(os.path.join(claude_dir(), "plugins", "cache", market, name))
                      if VERSION.match(v)]
        except OSError:
            cached = []
        newest = max(cached, key=vkey) if cached else None
        status = "ok"
        if loaded and newest and VERSION.match(loaded) and vkey(newest) > vkey(loaded):
            status = f"stale: {newest} is in the cache; run claude plugin update {name}, then restart"
        result["data"]["rows"].append({"plugin": name, "marketplace": market, "loaded": loaded,
                                       "newest": newest, "status": status})
    out(result)


def show_session(sid):
    match = next((t for t in transcripts() if t[0] == sid), None)
    if match is None:
        return out({"widgets": []})
    _, path, mtime, size = match
    h = head(path)
    messages = 0
    try:
        with open(path, "rb") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict) and rec.get("type") in ("user", "assistant"):
                    messages += 1
    except OSError:
        pass
    started = from_iso(h["started"]) if "started" in h else None
    facts = [
        ("Project", h.get("cwd")),
        ("Branch", h.get("branch")),
        ("Started", local(started) if started else None),
        ("Last activity", local(mtime)),
        ("Claude Code", h.get("version")),
        ("Transcript", f"{path} ({round(size / 1024)} KB)"),
    ]
    out({"widgets": [
        {"id": "messages", "kind": "stat", "title": "Messages",
         "data": {"value": messages, "label": "user and assistant records"}},
        {"id": "details", "kind": "list", "title": "Session",
         "data": {"items": [{"text": k, "detail": v} for k, v in facts if v]}},
    ]})


def main(argv):
    cmd = argv[1:3]
    if cmd == ["detect"]:
        return detect()
    if cmd == ["fetch", "sessions-today"]:
        return sessions_today()
    if cmd == ["fetch", "sessions"]:
        return sessions()
    if cmd == ["fetch", "plugins"]:
        return plugins()
    if cmd == ["show", "session"] and len(argv) == 4:
        return show_session(argv[3])
    print(f"unknown command: {' '.join(argv[1:])}", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
