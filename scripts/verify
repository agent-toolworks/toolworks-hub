#!/usr/bin/env bash
# verify — the source contract, its validator, and hub check-source, against
# fixture sources whose faults are known in advance.
#
#   1. CONTRACT      every schema loads, every $ref resolves, and no schema
#                    uses a keyword the validator does not enforce.
#   2. VALIDATOR     the keywords behave as JSON Schema says, on the cases
#                    where Python and JSON disagree (true is not 1).
#   3. CHECK-SOURCE  each fixture in fixtures/sources passes or fails for the
#                    reason it was built with, and a hung source is stopped
#                    along with what it started.
#   4. DISCOVERY     against a fake home (fixtures/build-home): every state,
#                    name collisions, hub.json source_dirs, agent-teller
#                    never loaded or listed.
#   5. CLAUDE SOURCE the built-in source meets the contract and reads the
#                    fake home's sessions and plugins correctly.
#   6. SERVER        token, Host check, CSP, no CORS, idle exit, and
#                    hub open / stop.
#   7. VERSIONS      the hub and its Claude source agree.
#   8. GRAFANA       the example source, against a fake Grafana.
#   9. DOCS          the guide's example source passes check-source as written.
#
# Usage: scripts/verify
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HUB="$ROOT/scripts/hub"
FIX="$ROOT/fixtures/sources"
SID=11111111-2222-4333-8444-555555555555

PASS=0; FAIL=0
GREEN=$'\033[32m'; RED=$'\033[31m'; OFF=$'\033[0m'
[[ -t 1 ]] || { GREEN=; RED=; OFF=; }

ok()   { PASS=$((PASS+1)); printf '  %sPASS%s  %s\n' "$GREEN" "$OFF" "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  %sFAIL%s  %s\n' "$RED" "$OFF" "$1";
         [[ -n ${2:-} ]] && printf '%s\n' "$2" | sed 's/^/        /'; }
head_() { printf '\n%s\n%s\n' "$1" "$(printf '%.0s-' {1..70})"; }

command -v python3 >/dev/null 2>&1 || { echo "verify: python3 required"; exit 2; }

# timeout(1) is not on a stock macOS; perl's alarm is everywhere this runs.
bounded() {
  local secs=$1; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  else
    perl -e 'my $s = shift; alarm $s; exec @ARGV or exit 127' "$secs" "$@"
  fi
}

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Python checks print "ok <what>" or "bad <what>" lines, counted here. Fed from
# a file, never a pipe: a pipe runs tally in a subshell, and its counts --
# failures included -- would be lost. (Process substitution around a heredoc
# hangs macOS's bash 3.2.)
tally() {
  local line
  while IFS= read -r line; do
    case $line in
      "ok "*)  ok "${line#ok }" ;;
      "bad "*) bad "${line#bad }" ;;
      *)       bad "unexpected output" "$line" ;;
    esac
  done
}

head_ "1. CONTRACT"
python3 - "$ROOT/hub" > "$TMP/py1.out" 2>&1 <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
import contract
for name in contract.SCHEMAS:
    try:
        contract.load(name)
        print(f"ok {name} loads; its keywords are enforced and its $refs resolve")
    except contract.ContractError as e:
        print(f"bad {name}: {e}")
types = contract.entities()["types"]
print("ok entities.json defines session" if "session" in types else "bad entities.json lacks session")
try:
    contract.audit({"type": "string", "format": "date-time"}, "probe")
    print("bad a keyword the validator does not enforce was accepted")
except contract.ContractError:
    print("ok a keyword the validator does not enforce is refused")
EOF
tally < "$TMP/py1.out"

head_ "2. VALIDATOR"
python3 - "$ROOT/hub" > "$TMP/py2.out" 2>&1 <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from contract import validate

M = {"contract": 1, "name": "x", "title": "X", "version": "1", "network": False}
T = {"kind": "timeseries", "data": {"series": [{"name": "n", "points": [{"t": "2026-10-17T09:00:00Z", "v": 1}]}]}}

def case(what, instance, schema, want_valid, needle=""):
    errors = validate(instance, schema)
    if want_valid and not errors:
        print(f"ok {what}")
    elif not want_valid and errors and needle in " | ".join(errors):
        print(f"ok {what}")
    else:
        print(f"bad {what}: {errors or 'no errors'}")

case("a minimal manifest is valid", M, "manifest.schema.json", True)
case("contract true is not contract 1", {**M, "contract": True}, "manifest.schema.json", False, "must be 1")
case("timeout_seconds 10.5 is not an integer", {**M, "timeout_seconds": 10.5}, "manifest.schema.json", False, "expected integer")
case("timeout_seconds true is not an integer", {**M, "timeout_seconds": True}, "manifest.schema.json", False, "expected integer")
case("timeout_seconds above 60 is refused", {**M, "timeout_seconds": 61}, "manifest.schema.json", False, "maximum")
case("shows may not repeat a type", {**M, "shows": ["session", "session"]}, "manifest.schema.json", False, "more than once")
case("working needs no reason", {"state": "working"}, "detect.schema.json", True)
case("broken needs a reason", {"state": "broken"}, "detect.schema.json", False, "missing 'reason'")
case("not_installed is the hub's state, not a source's", {"state": "not_installed", "reason": "x"}, "detect.schema.json", False, "must be one of")
case("a timeseries with offset times is valid", T, "fetch.schema.json", True)
case("a time without an offset is refused",
     {"kind": "timeseries", "data": {"series": [{"name": "n", "points": [{"t": "2026-10-17T09:00:00", "v": 1}]}]}},
     "fetch.schema.json", False, "with an offset")
case("data is checked against its kind", {"kind": "stat", "data": {"series": []}}, "fetch.schema.json", False, "missing 'value'")
case("a table cell that is neither a value nor a ref is refused",
     {"kind": "table", "data": {"columns": [{"id": "a", "title": "A"}], "rows": [{"a": {"x": 1}}]}},
     "fetch.schema.json", False, "matches no allowed form")
case("a table cell may be a ref",
     {"kind": "table", "data": {"columns": [{"id": "a", "title": "A"}], "rows": [{"a": {"ref": "session", "id": "s"}}]}},
     "fetch.schema.json", True)
case("show output carries a kind per widget",
     {"widgets": [{"id": "w", "kind": "stat", "title": "W", "data": {"value": "4"}}]}, "show.schema.json", True)
EOF
tally < "$TMP/py2.out"

head_ "3. CHECK-SOURCE"
OUT=; RC=
check() {  # folder, then check-source arguments after it
  local name=$1; shift
  OUT=$(bounded 30 "$HUB" check-source "$FIX/$name" "$@" 2>&1); RC=$?
}
expect() {  # label, expected exit status, then strings the output must hold
  local label=$1 want=$2; shift 2
  local missing=
  for s in "$@"; do grep -qF -- "$s" <<<"$OUT" || missing+="missing: $s"$'\n'; done
  if [[ $RC == "$want" && -z $missing ]]; then ok "$label"
  else bad "$label (exit $RC, wanted $want)" "${missing}${OUT}"; fi
}

check passes --entity session=$SID
expect "passes: every check, with a warning that does not fail it" 0 \
  "PASS  fetch find" "PASS  fetch recent" "PASS  show session $SID" \
  "entity type 'ticket' is not in contract/entities.json" "0 failed"

check not-set-up
expect "not-set-up: passes, with fetch skipped and the fix shown" 0 \
  "SKIP  fetch and show" "fix: ts fixes apply statusline"

check bad-manifest
expect "bad-manifest: every fault named" 1 \
  '$.name: "Bad Name" is not a slug' '$.title: must not be empty' \
  '$.network: expected boolean' "unexpected 'colour'" 'got "pie"' \
  "id 'a' is used more than once" "points outside the source folder"

check newer-contract
expect "newer-contract: refused as written for another contract" 1 "written for contract 2"

check no-run
expect "no-run: refused" 1 "there is no \`run\` program"

check not-executable
expect "not-executable: refused" 1 "is not executable"

check not-json
expect "not-json: refused" 1 "did not print valid JSON"

check detect-no-reason
expect "detect-no-reason: a non-working state needs a reason" 1 "missing 'reason'"

check wrong-shape --entity session=$SID
expect "wrong-shape: every fault named" 1 \
  "'ghost' is not one of the columns" "'not-a-uuid' is not a valid session ID" \
  "matches no allowed form" "the manifest says 'stat', fetch printed 'table'" \
  "is not an ISO 8601 time with an offset" "expected number or null, got string" \
  "SKIP  fetch q" "unexpected 'colour'"

check passes --entity ticket=PROJ-1
expect "an entity the source does not show is refused" 1 "does not list 'ticket' in shows"

check passes --entity session=nope
expect "an entity ID that breaks its rule is refused before run is called" 1 "'nope' is not a valid session ID"

OUT=$("$HUB" check-source "$FIX/passes" --entity bad 2>&1); RC=$?
expect "bad --entity is a usage error" 2 "--entity wants TYPE=ID"

start=$SECONDS
HUB_TEST_PIDFILE="$TMP/hang.pid" check hangs
expect "hangs: stopped at the detect limit" 1 "took longer than 5 s"
elapsed=$((SECONDS - start))
(( elapsed <= 9 )) && ok "hangs: stopped in ${elapsed}s" || bad "hangs: took ${elapsed}s"
if [[ -s $TMP/hang.pid ]] && ! kill -0 "$(cat "$TMP/hang.pid")" 2>/dev/null; then
  ok "hangs: the child it left in the background was killed too"
else
  bad "hangs: its background child is still running, or never started"
fi

# Sections 4 to 6 run against a fake home (fixtures/build-home), never the
# real one: a verify run must not read or touch the operator's Claude Code.
HOME_FIX="$TMP/home"
"$ROOT/fixtures/build-home" "$HOME_FIX"
in_home() {
  CLAUDE_CONFIG_DIR="$HOME_FIX/claude" XDG_CONFIG_HOME="$HOME_FIX/config" \
  XDG_CACHE_HOME="$HOME_FIX/cache" HOME="$HOME_FIX/home" "$@"
}
RECENT=aaaaaaaa-1111-4222-8333-444444444444

head_ "4. DISCOVERY"
in_home bounded 30 "$HUB" status --json > "$TMP/status.json" 2>&1 || bad "hub status --json failed" "$(cat "$TMP/status.json")"
python3 - "$TMP/status.json" > "$TMP/py4.out" 2>&1 <<'EOF'
import json, sys
st = json.load(open(sys.argv[1]))
got = {s["key"]: s for s in st["sources"]}
want = {
    "claude": ("built-in", "working", ""),
    "token-save-fixture": ("plugin", "working", ""),
    "code-search-fixture": ("plugin", "not_set_up", "no history database"),
    "from-future": ("user", "incompatible", "written for source contract 2"),
    "claude~2": ("user", "broken", "already used by the built-in source"),
    "user-broken": ("user", "broken", "did not print valid JSON"),
    "bad-show": ("user", "working", ""),
    "team-config": ("folder", "working", ""),
    "solo": ("folder", "not_set_up", "no history database"),
}
for key, (origin, state, reason) in want.items():
    s = got.get(key)
    if s and s["origin"] == origin and s["state"] == state and reason in s["reason"]:
        print(f"ok {key}: {origin}, {state}")
    else:
        print(f"bad {key}: wanted {origin}/{state}/{reason!r}, got {s and (s['origin'], s['state'], s['reason'])}")
extra = set(got) - set(want)
print(f"bad unexpected sources: {sorted(extra)}" if extra else "ok no other sources, so agent-teller's hub-source was never loaded")
print("ok claude is found first, so it keeps its name" if st["sources"][0]["key"] == "claude"
      else f"bad first source is {st['sources'][0]['key']}")
print("ok source_dirs are read in order, after the user's folder" if [s["key"] for s in st["sources"]][-2:] == ["team-config", "solo"]
      else f"bad order: {[s['key'] for s in st['sources']]}")
probs = st["problems"]
print("ok a source_dirs folder that does not exist is a problem, not a failure"
      if len(probs) == 1 and "source_dirs names ~/missing, which is not a folder" in probs[0] else f"bad problems: {probs}")
names = [a["name"] for a in st["available"]]
print("ok only fleet-workspace is listed as not installed" if names == ["fleet-workspace"]
      else f"bad not installed: {names}")
a = st["available"][0] if st["available"] else {}
print("ok it comes with its install command" if a.get("install") == "/plugin install fleet-workspace@agent-toolworks"
      else f"bad install command: {a.get('install')}")
print("ok session is linkable, because working sources show it" if st.get("linkable") == ["session"]
      else f"bad linkable: {st.get('linkable')}")
EOF
tally < "$TMP/py4.out"

CLAUDE_CONFIG_DIR="$TMP/nowhere" XDG_CONFIG_HOME="$TMP/nowhere" XDG_CACHE_HOME="$TMP/nowhere-cache" \
  HOME="$HOME_FIX/home" bounded 30 "$HUB" status --json > "$TMP/empty.json" 2>&1
python3 - "$TMP/empty.json" > "$TMP/py4b.out" 2>&1 <<'EOF'
import json, sys
st = json.load(open(sys.argv[1]))
keys = [(s["key"], s["state"]) for s in st["sources"]]
print("ok with nothing installed, only the Claude source, not set up" if keys == [("claude", "not_set_up")]
      else f"bad with nothing installed: {keys}")
print("ok and nothing is linkable, so references stay plain text" if st.get("linkable") == []
      else f"bad linkable with nothing working: {st.get('linkable')}")
print("ok and nothing listed as not installed, with no catalogue on disk" if st["available"] == []
      else f"bad available: {st['available']}")
EOF
tally < "$TMP/py4b.out"

# hub.json that is wrong is a problem the page shows, and never stops the hub.
python3 - "$ROOT/hub" "$TMP/hubjson" > "$TMP/py4c.out" 2>&1 <<'EOF'
import json, os, sys
sys.path.insert(0, sys.argv[1])
os.environ["XDG_CONFIG_HOME"] = sys.argv[2]
import discovery, paths
os.makedirs(os.path.dirname(paths.hub_config_path()), exist_ok=True)
for text, want, label in [
    ('[1]', "is not a JSON object", "not an object"),
    ('{"source_dirs": "x"}', "must be a list of folder paths", "source_dirs not a list"),
    ('{"source_dir": []}', "unknown setting 'source_dir'", "a misspelt setting"),
    ('{', "could not read", "not JSON"),
]:
    open(paths.hub_config_path(), "w").write(text)
    dirs, problems = discovery.source_dirs()
    print(f"ok hub.json {label}: a problem" if dirs == [] and any(want in p for p in problems)
          else f"bad hub.json {label}: {dirs} {problems}")
os.remove(paths.hub_config_path())
print("ok no hub.json: no folders, no problem" if discovery.source_dirs() == ([], []) else f"bad no hub.json: {discovery.source_dirs()}")
EOF
tally < "$TMP/py4c.out"

head_ "5. CLAUDE SOURCE"
OUT=$(in_home bounded 30 "$HUB" check-source "$ROOT/sources/claude" --entity session=$RECENT 2>&1); RC=$?
expect "it meets the contract, show included" 0 "PASS  fetch sessions" "PASS  fetch plugins" "PASS  show session $RECENT"
for w in sessions-today sessions plugins; do
  in_home "$ROOT/sources/claude/run" fetch $w > "$TMP/claude-$w.json" 2>&1
done
in_home "$ROOT/sources/claude/run" show session $RECENT > "$TMP/claude-show.json" 2>&1
python3 - "$TMP" > "$TMP/py5.out" 2>&1 <<'EOF'
import json, os, sys
t = sys.argv[1]
load = lambda n: json.load(open(os.path.join(t, n)))
v = load("claude-sessions-today.json")["data"]["value"]
print("ok one session active in the last 24 hours" if v == 1 else f"bad sessions today: {v}")
rows = load("claude-sessions.json")["data"]["rows"]
ids = [r["session"]["id"] for r in rows]
print("ok two sessions, newest first; the stray file and the session folder are not transcripts"
      if ids == ["aaaaaaaa-1111-4222-8333-444444444444", "bbbbbbbb-1111-4222-8333-444444444444"] else f"bad sessions: {ids}")
print("ok the project and branch come from the transcript" if rows and rows[0]["project"] == "/work/app" and rows[0]["branch"] == "main"
      else f"bad first row: {rows[:1]}")
plugins = {r["plugin"]: r for r in load("claude-plugins.json")["data"]["rows"]}
ts = plugins.get("token-save", {})
print("ok token-save 0.6.0 is stale, with 0.25.0 in the cache" if ts.get("status", "").startswith("stale: 0.25.0")
      else f"bad token-save row: {ts}")
print("ok agent-teller is not listed" if "agent-teller" not in plugins else "bad agent-teller is listed")
w = {x["id"]: x for x in load("claude-show.json")["widgets"]}
print("ok show counts the session's messages" if w.get("messages", {}).get("data", {}).get("value") == 2
      else f"bad show: {w}")
EOF
tally < "$TMP/py5.out"

head_ "6. SERVER"
INFO="$HOME_FIX/cache/agent-toolworks/server.json"
in_home env HUB_IDLE_SECONDS=4 python3 "$ROOT/hub/server.py" serve > "$TMP/serve.log" 2>&1 &
SERVER=$!
for _ in $(seq 50); do [[ -s $INFO ]] && break; sleep 0.1; done
if [[ ! -s $INFO ]]; then
  bad "the server did not write server.json" "$(cat "$TMP/serve.log")"
else
  PORT=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$INFO")
  TOKEN=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' "$INFO")
  BASE="http://127.0.0.1:$PORT"
  JAR="hub_token_$PORT=$TOKEN"
  code() { curl -s --noproxy '*' -o "$TMP/body" -w '%{http_code}' "$@"; }
  [[ $(stat -f %Lp "$INFO" 2>/dev/null || stat -c %a "$INFO") == 600 ]] && ok "server.json is readable by its owner only" || bad "server.json mode"
  [[ $(code "$BASE/api/status") == 403 ]] && ok "no token: refused" || bad "no token was not refused"
  [[ $(code -H "Cookie: hub_token_$PORT=wrong" "$BASE/api/status") == 403 ]] && ok "wrong token: refused" || bad "wrong token was not refused"
  [[ $(code -H "Cookie: $JAR" -H "Host: evil.example:$PORT" "$BASE/api/status") == 403 ]] \
    && ok "right token, foreign Host header (DNS rebinding): refused" || bad "foreign Host was not refused"
  curl -s --noproxy '*' -D "$TMP/headers" -o /dev/null "$BASE/?token=$TOKEN"
  grep -qi "^set-cookie: hub_token_$PORT=$TOKEN; Path=/; HttpOnly; SameSite=Strict" "$TMP/headers" \
    && grep -qi '^location: /' "$TMP/headers" \
    && ok "the token URL sets an HttpOnly, SameSite=Strict cookie and redirects to drop it" \
    || bad "token URL response" "$(cat "$TMP/headers")"
  [[ $(code -H "Cookie: $JAR" "$BASE/") == 200 ]] && grep -q "Toolworks Hub" "$TMP/body" && ok "with the cookie, the page loads" || bad "page did not load"
  curl -s --noproxy '*' -D "$TMP/headers" -o /dev/null -H "Cookie: $JAR" "$BASE/api/status"
  grep -qi "^content-security-policy: default-src 'self'" "$TMP/headers" && ok "responses carry a Content-Security-Policy" || bad "no CSP"
  grep -qi '^access-control-allow-origin' "$TMP/headers" && bad "a CORS header is sent" || ok "no CORS headers, so no other origin can read a response"
  code -H "Cookie: $JAR" "$BASE/api/status" > /dev/null
  python3 -c 'import json,sys; st=json.load(open(sys.argv[1])); assert [s["key"] for s in st["sources"]][0] == "claude"' "$TMP/body" \
    && ok "/api/status lists the sources" || bad "/api/status" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/claude/widgets/sessions-today") == 200 ]] \
    && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["data"]["value"] == 1 and "fetched_at" in d' "$TMP/body" \
    && ok "a widget is fetched through the server" || bad "widget fetch" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/code-search-fixture/widgets/count") == 409 ]] \
    && ok "a source that is not set up is never fetched" || bad "not-set-up source was fetched"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/token-save-fixture/widgets/find?query=history") == 200 ]] \
    && grep -q '"evidence": "resolved"' "$TMP/body" && ok "a search widget runs the query" || bad "search" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/team-config/widgets/value") == 200 ]] \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["data"]["value"] == 7' "$TMP/body" \
    && ok "a source_dirs source reads its settings from TOOLWORKS_SOURCE_CONFIG" || bad "team-config fetch" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/nope/widgets/x") == 404 ]] && ok "an unknown source is a 404" || bad "unknown source"
  [[ $(code -X POST -H "Cookie: $JAR" "$BASE/api/status") == 501 ]] && ok "only GET is served" || bad "POST was served"

  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/session/$RECENT") == 200 ]] || bad "entity page: HTTP error" "$(head -c 400 "$TMP/body")"
  python3 - "$TMP/body" > "$TMP/py6.out" 2>&1 <<'EOF'
import json, sys
page = json.load(open(sys.argv[1]))
secs = {s["source"]: s for s in page["sections"]}
print("ok the session page has a section from each source that shows sessions"
      if list(secs) == ["claude", "token-save-fixture", "bad-show"] else f"bad sections: {list(secs)}")
c = {w["id"]: w for w in secs.get("claude", {}).get("widgets", [])}
print("ok the Claude section counts the session's messages" if c.get("messages", {}).get("data", {}).get("value") == 2
      else f"bad Claude section: {secs.get('claude')}")
b = secs.get("bad-show", {})
print("ok a source whose show breaks the contract keeps its section, as an error"
      if "breaks the contract" in b.get("error", {}).get("problem", "") and "widgets" not in b
      else f"bad bad-show section: {b}")
EOF
  tally < "$TMP/py6.out"
  code -H "Cookie: $JAR" "$BASE/api/entities/session/bbbbbbbb-1111-4222-8333-444444444444" > /dev/null
  python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert "claude" in [s["source"] for s in p["sections"]]' "$TMP/body" \
    && ok "the older session has a page too" || bad "older session page" "$(head -c 400 "$TMP/body")"
  code -H "Cookie: $JAR" "$BASE/api/entities/session/dddddddd-1111-4222-8333-444444444444" > /dev/null
  python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert "claude" not in [s["source"] for s in p["sections"]]' "$TMP/body" \
    && ok "a source that knows nothing about a session leaves its section out" || bad "unknown session" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/session/not-an-id") == 400 ]] && ok "an ID that breaks its type's rule is a 400" || bad "bad entity id"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/ticket/PROJ-1") == 404 ]] && ok "an entity type the contract does not define is a 404" || bad "unknown entity type"

  start=$SECONDS
  while kill -0 $SERVER 2>/dev/null && (( SECONDS - start < 15 )); do sleep 0.2; done
  if kill -0 $SERVER 2>/dev/null; then bad "the server did not exit when idle"; kill $SERVER
  else ok "the server exits on its own when idle"; fi
  [[ ! -e $INFO ]] && ok "and removes server.json when it does" || bad "server.json was left behind"
fi

OUT=$(in_home bounded 30 "$HUB" open --no-browser 2>&1); RC=$?
URL1=$OUT
expect "hub open starts a server and prints its URL" 0 "http://127.0.0.1:"
OUT=$(in_home bounded 30 "$HUB" open --no-browser 2>&1); RC=$?
[[ $RC == 0 && $OUT == "$URL1" ]] && ok "a second hub open reuses the running server" || bad "second hub open" "$URL1 / $OUT"
OUT=$(in_home bounded 30 "$HUB" stop 2>&1); RC=$?
expect "hub stop stops it" 0 "hub: stopped"
OUT=$(in_home bounded 30 "$HUB" stop 2>&1); RC=$?
expect "hub stop with nothing running says so" 0 "hub: not running"

head_ "7. VERSIONS"
HUBV=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from version import VERSION; print(VERSION)' "$ROOT/hub")
SRCV=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$ROOT/sources/claude/source.json")
[[ $HUBV == "$SRCV" ]] && ok "the hub and its Claude source are both $HUBV" || bad "hub $HUBV, Claude source $SRCV"

head_ "8. GRAFANA EXAMPLE"
# examples/grafana against a fake Grafana on 127.0.0.1: no network, no Keychain.
python3 "$ROOT/fixtures/grafana_cases.py" "$ROOT" "$TMP" > "$TMP/py8.out" 2>&1
tally < "$TMP/py8.out"

head_ "9. DOCS"
# The guide's first source, copied out of docs/writing-a-source.md exactly as a
# reader would, must pass check-source: a guide that drifts from the contract
# teaches the wrong thing to everyone who follows it.
mkdir -p "$TMP/guide-disk"
python3 - "$ROOT/docs/writing-a-source.md" "$TMP/guide-disk" <<'EOF'
import re, sys
blocks = re.findall(r"```(\w*)\n(.*?)```", open(sys.argv[1]).read(), re.S)
open(sys.argv[2] + "/source.json", "w").write(next(b for l, b in blocks if l == "json" and '"name": "disk"' in b))
open(sys.argv[2] + "/run", "w").write(next(b for l, b in blocks if l == "sh" and b.startswith("#!/bin/sh")))
EOF
chmod +x "$TMP/guide-disk/run"
OUT=$(bounded 30 "$HUB" check-source "$TMP/guide-disk" 2>&1); RC=$?
expect "the guide's first source passes check-source as written" 0 "PASS  fetch free" "0 failed"

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
(( FAIL == 0 ))
