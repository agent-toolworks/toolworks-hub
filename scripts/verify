# Session tables and the session page: what the hub adds about each session,
# opening one, and its transcript, on the fake claude and the fixture's
# transcripts (the older one has titles, a bridge and tool uses).
in_home env TOOLWORKS_CLAUDE_BIN="$ROOT/fixtures/fake-claude" FAKE_CLAUDE_LOG="$TMP/fake-claude.log" \
  python3 - "$ROOT" "$HOME_FIX" > "$TMP/py5d.out" 2>&1 <<'EOF'
import json, os, sys
root, fix = sys.argv[1:3]
sys.path.insert(0, os.path.join(root, "hub"))
import sessions
RECENT, OLD = "aaaaaaaa-1111-4222-8333-444444444444", "bbbbbbbb-1111-4222-8333-444444444444"
LIVE = "dddddddd-1111-4222-8333-444444444444"
own = os.path.join(fix, "claude")
d = sessions.describe_all([RECENT, OLD, LIVE, "not-a-session"])
r, o, l = d.get(RECENT, {}), d.get(OLD, {}), d.get(LIVE, {})
print("ok only session IDs are described" if sorted(d) == [RECENT, OLD, LIVE] else f"bad ids: {sorted(d)}")
print("ok a live background session has its state, short id and the links of its job"
      if r.get("status") == "busy" and r.get("kind") == "background" and r.get("short_id") == "aaaa1111"
      and r.get("app_link") == "claude://code/session_01AbCdEf" and r.get("unavailable") == {} else f"bad live: {r}")
print("ok a session no process holds has ended; its title is its last custom-title, over ai-title"
      if o.get("status") == "ended" and o.get("title") == "Build fix" and o.get("cwd") == fix else f"bad ended: {o}")
print("ok an ended session's claude.ai bridge is its Browser link, but the app resumes it rather than open the bridge"
      if (o.get("links") or {}).get("web") == "https://claude.ai/code/session_01OldBridge" and o.get("app_link") is None
      and o.get("unavailable") == {} else f"bad ended links: {o}")
print("ok nothing else from the bridge record is passed on" if "secret-owner" not in json.dumps(d) else "bad the owner leaked")
print("ok a live session open in a terminal, and not bridged, cannot be opened again; each button says why"
      if l.get("status") == "idle" and set(l.get("unavailable", {})) == {"app", "terminal", "web"}
      and "folder it ran in" in l["unavailable"]["terminal"] else f"bad interactive: {l}")
cmd = sessions.terminal_command(OLD, o)
print("ok Terminal resumes an ended session in its folder, on its Claude Code folder"
      if cmd.startswith(f"cd {fix} && CLAUDE_CONFIG_DIR={own} ") and cmd.endswith(f" --resume {OLD}") else f"bad command: {cmd}")
cmd = sessions.terminal_command(RECENT, r)
print("ok a live background session is attached to, not resumed" if cmd.endswith(" attach aaaa1111") else f"bad attach: {cmd}")
try:
    sessions.open_session(LIVE, "terminal")
    print("bad a session open in a terminal was opened again")
except sessions.Failed as e:
    print("ok opening one that is not offered is refused, saying why" if "folder it ran in" in str(e) else f"bad refusal: {e}")
try:
    sessions.open_session(OLD, "printer")
    print("bad an unknown place was accepted")
except sessions.Failed:
    print("ok a session opens in the app or a terminal only")
print("ok a running bridged session opens in the app at its claude:// link"
      if sessions.open_session(RECENT, "app") == {"opened": "app", "link": "claude://code/session_01AbCdEf"} else "bad app link")
open(os.environ["FAKE_CLAUDE_LOG"], "w").close()
got = sessions.open_session(OLD, "app")
calls = [json.loads(x) for x in open(os.environ["FAKE_CLAUDE_LOG"])]
desk = [c for c in calls if c["args"][:1] == ["--desktop"]]
print("ok any other is resumed in the app with claude --desktop --resume, on a terminal of its own, in its folder"
      if got.get("opened") == "app" and "Opening session" in got.get("said", "") and desk
      and desk[0]["args"] == ["--desktop", "--resume", OLD] and desk[0]["cwd"] == os.path.realpath(fix)
      and desk[0]["env"]["CLAUDE_CONFIG_DIR"] == own else f"bad desktop: {got} {desk}")

t = sessions.transcript(OLD)
kinds = [(e["role"], e["kind"], e.get("tool"), e["text"]) for e in t["entries"]]
print("ok the transcript: typed text, commands, answers and tool uses with their summary, oldest first"
      if kinds == [("user", "text", None, "hi"), ("assistant", "text", None, "hello"), ("user", "command", None, "/clear"),
                   ("assistant", "text", None, "Running the tests."), ("assistant", "tool", "Bash", "Run the tests")]
      else f"bad transcript: {kinds}")
text = json.dumps(t)
print("ok thinking, tool results, subagents and Claude Code's own records are left out"
      if not any(x in text for x in ("secret thoughts", "tool output", "subagent words", "injected", "local-command"))
      else f"bad left in: {text}")
page = sessions.transcript(OLD, before=4, limit=2)
print("ok the transcript is read a page at a time, back from the end"
      if page["total"] == 5 and page["start"] == 2 and [e["text"] for e in page["entries"]] == ["/clear", "Running the tests."]
      else f"bad page: {page}")
table = {"kind": "table", "data": {"columns": [{"id": "s", "title": "S"}],
         "rows": [{"s": {"ref": "session", "id": OLD}}, {"s": "plain"}]}}
plain = {"kind": "table", "data": {"columns": [], "rows": [{"a": 1}]}}
e = sessions.enrich(table)
print("ok a table of sessions gets each one's status, title and links; another table is left as it is"
      if list(e.get("sessions", {})) == [OLD] and e["data"] == table["data"] and sessions.enrich(plain) == plain
      else f"bad enrich: {e}")
EOF
tally < "$TMP/py5d.out"

head_ "6. SERVER"
INFO="$HOME_FIX/cache/agent-toolworks/server.json"
in_home env HUB_IDLE_SECONDS=4 TOOLWORKS_CLAUDE_BIN="$ROOT/fixtures/fake-claude" FAKE_CLAUDE_LOG="$TMP/fake-claude.log" python3 "$ROOT/hub/server.py" serve > "$TMP/serve.log" 2>&1 &
SERVER=$!
for _ in $(seq 50); do [[ -s $INFO ]] && break; sleep 0.1; done
if [[ ! -s $INFO ]]; then
  bad "the server did not write server.json" "$(cat "$TMP/serve.log")"
else
  PORT=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$INFO")
  TOKEN=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' "$INFO")
  BASE="http://127.0.0.1:$PORT"
  JAR="hub_token_$PORT=$TOKEN"
  code() { curl -s --noproxy '*' -o "$TMP/body" -w '%{http_code}' "$@"; }
  [[ $(stat -f %Lp "$INFO" 2>/dev/null || stat -c %a "$INFO") == 600 ]] && ok "server.json is readable by its owner only" || bad "server.json mode"
  [[ $(code "$BASE/api/status") == 403 ]] && ok "no token: refused" || bad "no token was not refused"
  [[ $(code -H "Cookie: hub_token_$PORT=wrong" "$BASE/api/status") == 403 ]] && ok "wrong token: refused" || bad "wrong token was not refused"
  [[ $(code -H "Cookie: $JAR" -H "Host: evil.example:$PORT" "$BASE/api/status") == 403 ]] \
    && ok "right token, foreign Host header (DNS rebinding): refused" || bad "foreign Host was not refused"
  curl -s --noproxy '*' -D "$TMP/headers" -o /dev/null "$BASE/?token=$TOKEN"
  grep -qi "^set-cookie: hub_token_$PORT=$TOKEN; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000" "$TMP/headers" \
    && grep -qi '^location: /' "$TMP/headers" \
    && ok "the token URL sets an HttpOnly, SameSite=Strict cookie that lasts a year, and redirects to drop it" \
    || bad "token URL response" "$(cat "$TMP/headers")"
  [[ $(code -H "Cookie: $JAR" "$BASE/") == 200 ]] && grep -q "Toolworks Hub" "$TMP/body" && ok "with the cookie, the page loads" || bad "page did not load"
  curl -s --noproxy '*' -D "$TMP/headers" -o "$TMP/body" -H "Cookie: $JAR" "$BASE/static/favicon.svg"
  grep -qi '^content-type: image/svg+xml' "$TMP/headers" && grep -q '<svg' "$TMP/body" && ok "the favicon is served as SVG" || bad "favicon" "$(cat "$TMP/headers")"
  curl -s --noproxy '*' -D "$TMP/headers" -o /dev/null -H "Cookie: $JAR" "$BASE/api/status"
  grep -qi "^content-security-policy: default-src 'self'" "$TMP/headers" && ok "responses carry a Content-Security-Policy" || bad "no CSP"
  grep -qi '^access-control-allow-origin' "$TMP/headers" && bad "a CORS header is sent" || ok "no CORS headers, so no other origin can read a response"
  code -H "Cookie: $JAR" "$BASE/api/status" > /dev/null
  python3 -c 'import json,sys; st=json.load(open(sys.argv[1])); assert [s["key"] for s in st["sources"]][0] == "claude"' "$TMP/body" \
    && ok "/api/status lists the sources" || bad "/api/status" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/claude/widgets/sessions-today") == 200 ]] \
    && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["data"]["value"] == 1 and "fetched_at" in d' "$TMP/body" \
    && ok "a widget is fetched through the server" || bad "widget fetch" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/solo/widgets/count") == 409 ]] \
    && ok "a source that is not set up is never fetched" || bad "not-set-up source was fetched"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/token-save-fixture/widgets/find?query=history") == 200 ]] \
    && grep -q '"evidence": "resolved"' "$TMP/body" && ok "a search widget runs the query" || bad "search" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/team-config/widgets/value") == 200 ]] \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["data"]["value"] == 7' "$TMP/body" \
    && ok "a source_dirs source reads its settings from TOOLWORKS_SOURCE_CONFIG" || bad "team-config fetch" "$(head -c 400 "$TMP/body")"
  # The hub's page for code-search: a view, framed by the hub's page only,
  # answered through `run call`.
  code -H "Cookie: $JAR" "$BASE/api/status" > /dev/null
  python3 -c 'import json,sys; v={s["key"]: s["view"] for s in json.load(open(sys.argv[1]))["sources"]}; assert v.pop("code-search") == "/views/code-search/index.html" and v.pop("own-page") == "/sources/own-page/page/index.html" and not any(v.values()), v' "$TMP/body" \
    && ok "code-search has the hub's page, own-page its own, and no other source has one" || bad "views in status" "$(head -c 400 "$TMP/body")"
  for f in index.html view.js view.css; do
    curl -s --noproxy '*' -D "$TMP/headers" -o "$TMP/body" -H "Cookie: $JAR" "$BASE/views/code-search/$f"
    if grep -qi "^content-security-policy: .*frame-ancestors 'self'" "$TMP/headers" && grep -qi '^x-frame-options: SAMEORIGIN' "$TMP/headers" \
       && head -1 "$TMP/headers" | grep -q ' 200'; then ok "view $f: served, framable by the hub's own page only"
    else bad "view $f" "$(cat "$TMP/headers")"; fi
  done
  grep -qiE "(src|href)[[:space:]]*=[[:space:]]*[\"']?(https?:)?//" "$ROOT/web/views/code-search/index.html" \
    && bad "the view loads something remote" || ok "the view loads nothing from the network"
  [[ $(code -H "Cookie: $JAR" "$BASE/views/code-search/..%2Fapp.js") == 404 ]] && ok "a view path cannot climb out of its folder" || bad "view path escape"
  # A source's own page: page/ in its folder, nested paths and images too,
  # under the same headers as a view the hub ships.
  for f in index.html _lib/App.js img/dot.svg; do
    curl -s --noproxy '*' -D "$TMP/headers" -o "$TMP/body" -H "Cookie: $JAR" "$BASE/sources/own-page/page/$f"
    if grep -qi "^content-security-policy: .*frame-ancestors 'self'" "$TMP/headers" && grep -qi '^x-frame-options: SAMEORIGIN' "$TMP/headers" \
       && head -1 "$TMP/headers" | grep -q ' 200' && cmp -s "$TMP/body" "$FIX/own-page/page/$f"; then ok "own page $f: served from the source's folder, framable by the hub's own page only"
    else bad "own page $f" "$(cat "$TMP/headers")"; fi
  done
  grep -qi '^content-type: image/svg+xml' "$TMP/headers" && ok "an image in a page is served with its type" || bad "own page svg type" "$(cat "$TMP/headers")"
  curl -s --noproxy '*' -D "$TMP/headers" -o "$TMP/body" -H "Cookie: $JAR" "$BASE/sources/own-page/page/fonts/Face.woff2"
  head -1 "$TMP/headers" | grep -q ' 200' && grep -qi '^content-type: font/woff2' "$TMP/headers" \
    && ok "a font in a page is served with its type" || bad "own page font" "$(cat "$TMP/headers")"
  [[ $(code -H "Cookie: $JAR" "$BASE/sources/own-page/page/notes.txt") == 404 ]] && ok "a page file of another type is not served" || bad "own page txt"
  [[ $(code -H "Cookie: $JAR" "$BASE/sources/own-page/page/.secret.js") == 404 ]] && ok "a hidden page file is not served" || bad "own page hidden file"
  [[ $(code -H "Cookie: $JAR" "$BASE/sources/own-page/page/..%2Fsource.json") == 404 \
     && $(code --path-as-is -H "Cookie: $JAR" "$BASE/sources/own-page/page/img/../../source.json") == 404 ]] && ok "a page path cannot climb out of page/" || bad "own page path escape"
  [[ $(code -H "Cookie: $JAR" "$BASE/sources/own-page/page/outside.json") == 404 ]] && ok "a link out of page/ is not followed" || bad "own page symlink escape"
  [[ $(code -H "Cookie: $JAR" "$BASE/sources/solo/page/index.html") == 404 ]] && ok "a source with no page serves none" || bad "page of a source without one"
  [[ $(code "$BASE/sources/own-page/page/index.html") == 403 ]] && ok "a page needs the token" || bad "own page without token"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/own-page/call/echo?args=%7B%7D") == 200 ]] \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1])) == {"op": "echo", "args": {}}' "$TMP/body" \
    && ok "a source with its own page is called" || bad "own page call" "$(head -c 400 "$TMP/body")"
  curl -s --noproxy '*' -D "$TMP/headers" -o /dev/null -H "Cookie: $JAR" "$BASE/"
  grep -qi '^x-frame-options: DENY' "$TMP/headers" && ok "the hub's own page still cannot be framed" || bad "hub page framing"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/code-search/call/echo?args=%7B%22q%22%3A%22a%20b%22%7D") == 200 ]] \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1])) == {"op": "echo", "args": {"q": "a b"}}' "$TMP/body" \
    && ok "a call reaches run call with its JSON arguments" || bad "call echo" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/code-search/call/fail") == 502 ]] && grep -q "the service is down" "$TMP/body" \
    && ok "a call that fails is a 502 with its stderr" || bad "call fail" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/code-search/call/echo?args=%5B1%5D") == 400 ]] && ok "call arguments must be a JSON object" || bad "call array args"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/code-search/call/Bad%20Op") == 400 ]] && ok "a call name is checked before run is called" || bad "call bad op"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/token-save-fixture/call/echo") == 404 ]] && ok "a source with no page is never called" || bad "call without a view"
  [[ $(code "$BASE/api/sources/code-search/call/echo") == 403 ]] && ok "a call needs the token" || bad "call without token"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/nope/widgets/x") == 404 ]] && ok "an unknown source is a 404" || bad "unknown source"
  [[ $(code -X POST -H "Cookie: $JAR" "$BASE/api/status") == 404 ]] && ok "a POST is served only to open a session" || bad "POST was served"
  # Session tables and the session page, through the server.
  OLD=bbbbbbbb-1111-4222-8333-444444444444
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sources/claude/widgets/sessions") == 200 ]] \
    && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["sessions"][sys.argv[2]]["title"] == "Build fix", d' "$TMP/body" "$OLD" \
    && ok "a session table comes with each session's status, title and links" || bad "session table" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sessions/$OLD") == 200 ]] && grep -q '"status": "ended"' "$TMP/body" \
    && ok "one session's status and title" || bad "session info" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sessions/$OLD/transcript?limit=2") == 200 ]] \
    && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["total"] == 5 and len(d["entries"]) == 2, d' "$TMP/body" \
    && ok "a session's transcript, a page at a time" || bad "transcript" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sessions/$OLD/transcript?before=x") == 400 ]] && ok "transcript paging takes numbers" || bad "transcript paging"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sessions/eeeeeeee-1111-4222-8333-444444444444/transcript") == 404 ]] \
    && ok "a session with no transcript is a 404" || bad "missing transcript"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/sessions/$OLD/open") == 404 ]] && ok "opening a session is a POST, never a GET" || bad "GET open"
  [[ $(code -X POST -H "Cookie: $JAR" -H "Content-Type: text/plain" --data '{"in":"terminal"}' "$BASE/api/sessions/$OLD/open") == 415 ]] \
    && ok "opening a session takes JSON only, which no other site's page can send unasked" || bad "open without JSON"
  [[ $(code -X POST -H "Content-Type: application/json" --data '{"in":"terminal"}' "$BASE/api/sessions/$OLD/open") == 403 ]] \
    && ok "opening a session needs the token" || bad "open without token"
  [[ $(code -X POST -H "Cookie: $JAR" -H "Content-Type: application/json" --data '{"in":"printer"}' "$BASE/api/sessions/$OLD/open") == 409 ]] \
    && grep -q "app or terminal" "$TMP/body" && ok "a refusal to open says why" || bad "open refusal" "$(head -c 400 "$TMP/body")"

  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/session/$RECENT") == 200 ]] || bad "entity page: HTTP error" "$(head -c 400 "$TMP/body")"
  python3 - "$TMP/body" > "$TMP/py6.out" 2>&1 <<'EOF'
import json, sys
page = json.load(open(sys.argv[1]))
secs = {s["source"]: s for s in page["sections"]}
print("ok the session page has a section from each source that shows sessions"
      if list(secs) == ["claude", "token-save-fixture", "bad-show"] else f"bad sections: {list(secs)}")
c = {w["id"]: w for w in secs.get("claude", {}).get("widgets", [])}
facts = {i["text"]: i["detail"] for i in c.get("details", {}).get("data", {}).get("items", [])}
print("ok the Claude section counts the session's messages" if facts.get("Messages", "").startswith("2 ")
      else f"bad Claude section: {secs.get('claude')}")
b = secs.get("bad-show", {})
print("ok a source whose show breaks the contract keeps its section, as an error"
      if "breaks the contract" in b.get("error", {}).get("problem", "") and "widgets" not in b
      else f"bad bad-show section: {b}")
EOF
  tally < "$TMP/py6.out"
  code -H "Cookie: $JAR" "$BASE/api/entities/session/bbbbbbbb-1111-4222-8333-444444444444" > /dev/null
  python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert "claude" in [s["source"] for s in p["sections"]]' "$TMP/body" \
    && ok "the older session has a page too" || bad "older session page" "$(head -c 400 "$TMP/body")"
  code -H "Cookie: $JAR" "$BASE/api/entities/session/dddddddd-1111-4222-8333-444444444444" > /dev/null
  python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); assert "claude" not in [s["source"] for s in p["sections"]]' "$TMP/body" \
    && ok "a source that knows nothing about a session leaves its section out" || bad "unknown session" "$(head -c 400 "$TMP/body")"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/session/not-an-id") == 400 ]] && ok "an ID that breaks its type's rule is a 400" || bad "bad entity id"
  [[ $(code -H "Cookie: $JAR" "$BASE/api/entities/ticket/PROJ-1") == 404 ]] && ok "an entity type the contract does not define is a 404" || bad "unknown entity type"

  start=$SECONDS
  while kill -0 $SERVER 2>/dev/null && (( SECONDS - start < 15 )); do sleep 0.2; done
  if kill -0 $SERVER 2>/dev/null; then bad "the server did not exit when idle"; kill $SERVER
  else ok "the server exits on its own when idle"; fi
  [[ ! -e $INFO ]] && ok "and removes server.json when it does" || bad "server.json was left behind"
fi

OUT=$(in_home bounded 30 "$HUB" open --no-browser 2>&1); RC=$?
URL1=$OUT
expect "hub open starts a server and prints its URL" 0 "http://127.0.0.1:"
OUT=$(in_home bounded 30 "$HUB" open --no-browser 2>&1); RC=$?
[[ $RC == 0 && $OUT == "$URL1" ]] && ok "a second hub open reuses the running server" || bad "second hub open" "$URL1 / $OUT"
OUT=$(in_home bounded 30 "$HUB" stop 2>&1); RC=$?
expect "hub stop stops it" 0 "hub: stopped"
OUT=$(in_home bounded 30 "$HUB" open --no-browser 2>&1); RC=$?
[[ $RC == 0 && ${OUT#*token=} == "${URL1#*token=}" ]] && ok "a restarted hub keeps its token, so a bookmark still works" \
  || bad "token after restart" "$URL1 / $OUT"
[[ $(stat -f %Lp "$HOME_FIX/cache/agent-toolworks/token" 2>/dev/null || stat -c %a "$HOME_FIX/cache/agent-toolworks/token") == 600 ]] \
  && ok "the kept token is readable by its owner only" || bad "token file mode"
in_home bounded 30 "$HUB" stop > /dev/null 2>&1

# The port: 7437 unless hub.json says otherwise, and a port in use is an
# error that names the fix, never a quiet move to another port.
python3 - "$ROOT/hub" "$TMP/portcfg" > "$TMP/py6p.out" 2>&1 <<'EOF'
import json, os, sys
sys.path.insert(0, sys.argv[1])
os.environ["XDG_CONFIG_HOME"] = sys.argv[2]
import discovery, paths
print("ok with no hub.json the port is 7437" if discovery.port_setting() == (7437, None) else f"bad default port: {discovery.port_setting()}")
os.makedirs(os.path.dirname(paths.hub_config_path()), exist_ok=True)
for value, want, label in [(8123, 8123, "a port in hub.json is used"), (0, 0, "port 0 asks for a free one"),
                           ("80", 7437, "a port that is not a number is a problem"), (70000, 7437, "a port above 65535 is a problem")]:
    json.dump({"port": value}, open(paths.hub_config_path(), "w"))
    port, problem = discovery.port_setting()
    print(f"ok {label}" if port == want and (problem is None) == (want == value) else f"bad {label}: {port} {problem}")
EOF
tally < "$TMP/py6p.out"
python3 -c 'import socket,time,sys; s=socket.socket(); s.bind(("127.0.0.1",0)); s.listen(); print(s.getsockname()[1], flush=True); time.sleep(20)' > "$TMP/busy.port" &
BUSY=$!
for _ in $(seq 50); do [[ -s $TMP/busy.port ]] && break; sleep 0.1; done
mkdir -p "$TMP/busycfg/agent-toolworks"
printf '{"port": %s}\n' "$(cat "$TMP/busy.port")" > "$TMP/busycfg/agent-toolworks/hub.json"
OUT=$(XDG_CONFIG_HOME="$TMP/busycfg" XDG_CACHE_HOME="$TMP/busycache" CLAUDE_CONFIG_DIR="$TMP/nowhere" \
  bounded 30 python3 "$ROOT/hub/server.py" serve 2>&1); RC=$?
expect "a port in use is an error that names the fix" 1 "is in use by another program" "or to 0 for a free port each time"
kill $BUSY 2>/dev/null
OUT=$(in_home bounded 30 "$HUB" stop 2>&1); RC=$?
expect "hub stop with nothing running says so" 0 "hub: not running"

head_ "7. VIEWS"
# The code-search view's grouping, run in node when it is installed: the hub
# itself needs only python3, so without node this is a skip, never a pass.
if command -v node >/dev/null 2>&1; then
  node - "$ROOT/web/views/code-search/view.js" > "$TMP/node7.out" 2>&1 <<'EOF'
const src = require("fs").readFileSync(process.argv[2], "utf8");
const m = src.match(/^function groupHits\([\s\S]*?^}/m);
if (!m) { console.log("bad groupHits is not in view.js"); process.exit(0); }
const groupHits = new Function(m[0] + "\nreturn groupHits;")();
const hit = (repo, line) => ({ repo, path: "a.py", line, text: "x" });
const g = groupHits([hit("b", 1), hit("a", 1), hit("b", 2), hit("a", 2), hit("b", 3), { text: "loose" }]);
const got = JSON.stringify(g.groups.map(x => [x.repo, x.hits.map(h => h.line)]));
console.log(got === '[["b",[1,2,3]],["a",[1,2]]]'
  ? "ok interleaved hits from two repos make two blocks, in first-seen order, hits in cs's order (#1)"
  : "bad interleaved hits grouped as " + got);
console.log(JSON.stringify(g.loose) === '["loose"]' ? "ok a hit with no path stays a loose line" : "bad loose: " + JSON.stringify(g.loose));
EOF
  tally < "$TMP/node7.out"
  node - "$ROOT/web/app.js" > "$TMP/node7b.out" 2>&1 <<'EOF'
const src = require("fs").readFileSync(process.argv[2], "utf8");
const grab = name => (src.match(new RegExp("^(const " + name + " = .*|function " + name + "\\([\\s\\S]*?^})", "m")) || [""])[0];
const f = new Function([grab("WEEKDAYS"), grab("resetsAt"), grab("timeLeft")].join("\n") + "\nreturn { resetsAt, timeLeft };")();
const fmt = [23 * 60e3, (4 * 60 + 5) * 60e3, ((2 * 24 + 6) * 60 + 59) * 60e3 + 1].map(f.timeLeft).join(" ");
console.log(fmt === "23m 4h5m 2d7h" ? "ok time left reads 23m, 4h5m, 2d7h" : "bad time left: " + fmt);
const now = new Date(2026, 9, 17, 12, 0);  // a Saturday, noon
const at = label => { const t = f.resetsAt(label, now); return t && (t - now) / 60e3; };
const got = [at("used; resets Sat 12:40"), at("used; resets Wed 20:00"), at("used; resets Sat 11:00"), at("used")].join(",");
console.log(got === [40, (4 * 24 + 8) * 60, 7 * 24 * 60 - 60, ""].join(",")
  ? "ok a reset is the next such weekday and time: later today, Wednesday, or next week"
  : "bad resets in minutes: " + got);
EOF
  tally < "$TMP/node7b.out"
  node - "$ROOT/web/app.js" > "$TMP/node7c.out" 2>&1 <<'EOF'
const src = require("fs").readFileSync(process.argv[2], "utf8");
const m = src.match(/^function rangeMs\([\s\S]*?^}/m);
const rangeMs = new Function(m[0] + "\nreturn rangeMs;")();
const got = ["6h", "12h", "3d", "30d", "5m", "0h"].map(rangeMs).join(",");
console.log(got === [6 * 3600e3, 12 * 3600e3, 3 * 86400e3, 30 * 86400e3, "", ""].join(",")
  ? "ok a range of 6h, 12h, 3d or 30d is that many milliseconds, and 5m or 0h is none"
  : "bad rangeMs: " + got);
EOF
  tally < "$TMP/node7c.out"
  node - "$ROOT/web/app.js" > "$TMP/node7d.out" 2>&1 <<'EOF'
const src = require("fs").readFileSync(process.argv[2], "utf8");
const grab = name => (src.match(new RegExp("^(const " + name + " = .*|function " + name + "\\([\\s\\S]*?^})", "m")) || [""])[0];
const splitFull = new Function([grab("FULL"), grab("splitFull")].join("\n") + "\nreturn splitFull;")();
const got = ["#/source/code-search/full", "#/source/code-search", "#/not-installed/full", ""].map(h => JSON.stringify(splitFull(h))).join(" ");
console.log(got === '{"tab":"#/source/code-search","full":true} {"tab":"#/source/code-search","full":false} {"tab":"#/not-installed","full":true} {"tab":"","full":false}'
  ? "ok a tab's hash plus /full is that tab on its own page" : "bad splitFull: " + got);
EOF
  tally < "$TMP/node7d.out"
  node - "$ROOT/web/app.js" > "$TMP/node7e.out" 2>&1 <<'EOF'
const src = require("fs").readFileSync(process.argv[2], "utf8");
const m = src.match(/^function linkCell\([\s\S]*?^}/m);
const el = (tag, attrs, text) => ({ tag, attrs, text });
const linkCell = new Function("el", m[0] + "\nreturn linkCell;")(el);
const web = linkCell({ link: "https://claude.ai/code/session_01AB", label: "claude.ai" });
const app = linkCell({ link: "claude://code/session_01AB", label: "open in app" });
const js = linkCell({ link: "javascript:alert(1)", label: "x" });
console.log(web.tag === "a" && web.attrs.target === "_blank" && web.attrs.rel === "noopener noreferrer" && web.text === "claude.ai"
  ? "ok an https link cell opens in a new tab" : "bad https link cell: " + JSON.stringify(web));
console.log(app.tag === "a" && app.attrs.href === "claude://code/session_01AB" && !app.attrs.target
  ? "ok a claude:// link cell is a plain link, handed to the app" : "bad claude link cell: " + JSON.stringify(app));
console.log(js === "x" ? "ok any other scheme is shown as text" : "bad javascript link cell: " + JSON.stringify(js));
EOF
  tally < "$TMP/node7e.out"
else
  printf '  SKIP  the code-search view grouping: node is not installed\n'
fi

