# hub bg (#7), on a fake claude. The hub's own folder is not ~/.claude, so a
# command on it carries CLAUDE_CONFIG_DIR; ~/.claude itself is reached with
# the variable unset.
in_home python3 - "$ROOT" "$HOME_FIX" "$TMP" > "$TMP/py5c.out" 2>&1 <<'EOF'
import json, os, subprocess, sys
root, fix, tmp = sys.argv[1:4]
sys.path.insert(0, os.path.join(root, "hub"))
import runner
hub = os.path.join(root, "scripts", "hub")
