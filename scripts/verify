GOOD = "cse_01AbCdEf"
rows = [
    {"id": "aaaa1111", "kind": "background", "sessionId": "aaaaaaaa-1111-4222-8333-444444444444", "name": "fix bug",
     "cwd": "/work/app", "state": "working", "status": "busy", "pid": 1, "startedAt": 1792900000000},
    {"id": "bbbb2222", "kind": "background", "state": "blocked"},          # keys missing: read with .get
    {"id": "cccc3333", "kind": "background", "state": "done"},             # a state file with a bad id
    {"kind": "interactive", "sessionId": "dddddddd-1111-4222-8333-444444444444", "status": "idle", "pid": 7},
    {"kind": "interactive", "status": "idle", "pid": 8},                   # no session id: never listed
    {"kind": "background", "state": "done"},                               # no id: not listed
]
json.dump(rows, open(os.path.join(own, "fake-agents.json"), "w"))
json.dump([{"id": "eeee5555", "kind": "background", "state": "done"}], open(os.path.join(default, "fake-agents.json"), "w"))
for sid, value in (("aaaa1111", GOOD), ("cccc3333", "cse_01AB; rm -rf /")):
    os.makedirs(os.path.join(own, "jobs", sid), exist_ok=True)
    json.dump({"bridgeSessionId": value, "bridgeOwnerAccountUuid": "secret-account"},
              open(os.path.join(own, "jobs", sid, "state.json"), "w"))

env = dict(os.environ, TOOLWORKS_CLAUDE_BIN=os.path.join(root, "fixtures", "fake-claude"), FAKE_CLAUDE_LOG=log,
           TOOLWORKS_CLAUDE_DIRS=os.pathsep.join([own, default]), CLAUDECODE="1",
           CLAUDE_CODE_EXECPATH="/stale/claude", CLAUDE_CODE_SESSION_ID="parent")
def bg(*args, cwd=None):
    r = subprocess.run([hub, "bg"] + list(args), env=env, cwd=cwd, capture_output=True, text=True)
    try:
        return r.returncode, json.loads(r.stdout)
    except ValueError:
        return r.returncode, {"stdout": r.stdout, "stderr": r.stderr}
def calls():
    out = [json.loads(l) for l in open(log)] if os.path.exists(log) else []
    open(log, "w").close()
    return out

rc, got = bg("list")
by = {s["id"]: s for s in got.get("sessions", [])}
print("ok bg list: background rows with an id, from every folder; interactive and id-less rows left out"
      if rc == 0 and sorted(by) == ["aaaa1111", "bbbb2222", "cccc3333", "eeee5555"] else f"bad bg list: {rc} {got}")
a = by.get("aaaa1111", {})
print("ok each row has its kind, and its pid while the process is alive"
      if a.get("pid") == 1 and a.get("kind") == "background" and by.get("bbbb2222", {}).get("pid", 0) is None
      else f"bad pid: {by}")
rc, got = bg("list", "--all-kinds")
inter = [s for s in got.get("sessions", []) if s["kind"] == "interactive"]
print("ok bg list --all-kinds adds interactive rows, keyed by session_id with id null; an id-less background row is still left out"
      if rc == 0 and len(got["sessions"]) == 5 and len(inter) == 1 and inter[0]["id"] is None and inter[0]["links"] is None
      and inter[0]["session_id"] == "dddddddd-1111-4222-8333-444444444444" and inter[0]["pid"] == 7 and inter[0]["status"] == "idle"
      else f"bad --all-kinds: {rc} {got}")
print("ok a bridged session has its claude.ai and claude:// links"
      if a.get("links") == {"web": "https://claude.ai/code/session_01AbCdEf", "app": "claude://code/session_01AbCdEf"}
      else f"bad links: {a.get('links')}")
print("ok no link without a state file, or with a bridge id of the wrong shape"
      if by.get("bbbb2222", {}).get("links") is None and by.get("cccc3333", {}).get("links") is None else f"bad links: {by}")
print("ok nothing else from the state file is passed on" if "secret-account" not in json.dumps(got) else "bad the account id leaked")
print("ok the start time is an ISO time" if a.get("started_at", "").endswith("Z") else f"bad started_at: {a.get('started_at')}")
seen = {c["folder"]: c["env"] for c in calls()}
print("ok each folder is listed with its own CLAUDE_CONFIG_DIR, and ~/.claude with none"
      if seen.get(own, {}).get("CLAUDE_CONFIG_DIR") == own and default in seen and seen[default]["CLAUDE_CONFIG_DIR"] is None
      else f"bad folders: {seen}")
print("ok the hub's session variables are not passed to claude"
      if all(e["CLAUDECODE"] is None and e["CLAUDE_CODE_EXECPATH"] is None and e["CLAUDE_CODE_SESSION_ID"] is None
             for e in seen.values()) else f"bad env: {seen}")

work = os.path.join(tmp, "bg-work")
os.makedirs(work, exist_ok=True)
json.dump({"mcpServers": {"tickets": {}, "approved": {}}}, open(os.path.join(work, ".mcp.json"), "w"))
json.dump({"projects": {os.path.realpath(work): {"enabledMcpjsonServers": ["approved"]}}},
          open(os.path.join(own, ".claude.json"), "w"))
rc, got = bg("start", "--cwd", work, "--name", "ticket 7", "--model", "haiku", "--prompt", "look at ticket 7",
             "--", "--permission-mode", "plan")
c = calls()
print("ok bg start runs claude --bg in the folder and returns its id"
      if rc == 0 and got.get("id") == "abc12345" and got.get("name") == "ticket 7" and c and c[0]["cwd"] == os.path.realpath(work)
      and c[0]["args"] == ["--bg", "--model", "haiku", "-n", "ticket 7", "--permission-mode", "plan", "look at ticket 7"]
      else f"bad start: {rc} {got} {c}")
print("ok it says when the folder's .mcp.json names a server not yet approved"
      if "tickets" in got.get("notice", "") and "approved," not in got.get("notice", "") else f"bad notice: {got.get('notice')}")
rc, got = bg("start", "--cwd", work, "--name", "x", "--prompt=--dangerously-skip-permissions")
print("ok a prompt that reads as an option is refused" if rc == 1 and "may not start with '-'" in got.get("error", "") and not calls()
      else f"bad option prompt: {rc} {got}")
rc, got = bg("start", "--cwd", os.path.join(tmp, "nowhere"), "--name", "x", "--prompt", "p")
print("ok a missing folder is refused" if rc == 1 and "no such folder" in got.get("error", "") else f"bad missing cwd: {rc} {got}")

# resume (#9): `claude --bg --resume <full id>` and nothing else, where the session ran.
full = "aaaaaaaa-1111-4222-8333-444444444444"
calls()
