calls()

rc, got = bg("finish", "aaaa1111")
c = calls()
print("ok bg finish stops, then removes, in the folder that lists the session"
      if rc == 0 and got.get("rm") == "removed aaaa1111" and [x["args"] for x in c[-2:]] == [["stop", "aaaa1111"], ["rm", "aaaa1111"]]
      and c[-1]["folder"] == own else f"bad finish: {rc} {got} {c}")
