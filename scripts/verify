      else f"bad finish of an exited session: {rc} {got}")
rc, got = bg("stop", "exited1", "--claude-dir", own)
print("ok bg stop of a session that is not running is an error" if rc == 1 and "not running" in got.get("error", "") else f"bad stop: {rc} {got}")
rc, got = bg("rm", "--claude-dir", own, "--", "--force")
print("ok an id that reads as an option is refused" if rc == 1 and "not a background session id" in got.get("error", "") else f"bad id: {rc} {got}")
rc, got = bg("finish", "zzzz9999")
print("ok an unknown id is an error naming the folders" if rc == 1 and "no background session zzzz9999" in got.get("error", "")
      else f"bad unknown id: {rc} {got}")
e2 = dict(env, TOOLWORKS_CLAUDE_BIN=os.path.join(tmp, "no-claude"))
r = subprocess.run([hub, "bg", "list"], env=e2, capture_output=True, text=True)
print("ok with no claude, bg list says where it looked" if "TOOLWORKS_CLAUDE_BIN" in json.loads(r.stdout)["problems"][0]
      else f"bad no claude: {r.stdout}")

# Through the runner, as the hub runs the Claude source: TOOLWORKS_HUB is set.
