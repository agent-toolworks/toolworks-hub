#!/usr/bin/env bash
# Meets the contract. Its list links to an entity type the contract does not
# define, which must warn without failing.
set -euo pipefail
case "${1:-} ${2:-}" in
  "detect ") echo '{"state": "working", "tool_version": "0.1.0"}' ;;
  "fetch sessions-today") echo '{"kind": "stat", "data": {"value": 4, "label": "since midnight"}}' ;;
  "fetch cost") echo '{"kind": "timeseries", "as_of": "2026-10-17T09:00:00Z", "data": {"unit": "USD", "series": [{"name": "cost", "points": [{"t": "2026-10-16T00:00:00Z", "v": 1.5}, {"t": "2026-10-17T00:00:00+03:00", "v": null}]}]}}' ;;
  "fetch recent") echo '{"kind": "table", "data": {"columns": [{"id": "session", "title": "Session"}, {"id": "cost", "title": "Cost", "unit": "USD"}], "rows": [{"session": {"ref": "session", "id": "11111111-2222-4333-8444-555555555555", "label": "token-save"}, "cost": 0.42}, {"session": "unknown", "cost": null}]}}' ;;
  "fetch notes") echo '{"kind": "list", "data": {"items": [{"text": "Ticket work", "ref": {"ref": "ticket", "id": "PROJ-1"}}]}}' ;;
  "fetch find") echo '{"kind": "search", "notice": "PARTIAL: one engine timed out", "data": {"results": [{"title": "history.py", "location": "scripts/lib/history.py:12", "evidence": "resolved"}]}}' ;;
  "show session") echo '{"widgets": [{"id": "cost", "kind": "stat", "title": "Cost", "data": {"value": 0.42, "unit": "USD"}}]}' ;;
  *) echo "unknown command: $*" >&2; exit 2 ;;
esac
